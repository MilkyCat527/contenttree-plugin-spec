{
  "$comment": "K2 ingest conformance matrix (valid & rejection checklist). Consuming plugin ingest implementations MUST return HTTP 204 with an empty body on every case (no oracle leakage) while accepting valid batches into the canonical stream and recording rejected batches as bad rows without persisting client IPs.",
  "protocol_version": 1,
  "cases": [
    {
      "id": "accept_aggregate_view_and_tags_feedback",
      "expect_accepted": true,
      "expected_http_status": 204,
      "ticket_overrides": {
        "mode": "aggregate",
        "sub": "anon",
        "vwr": { "k": "anon", "p": null, "t": "none" },
        "cap": ["view", "scroll", "section", "nav", "feedback", "error"]
      },
      "events": [
        {
          "t": "view",
          "rev": 2,
          "o": "host",
          "visible_ms": 18000,
          "engaged_ms": 14000,
          "max_scroll": 0.91,
          "sections": [{ "i": 0, "h": "1a2b3c4d", "ms": 12000 }],
          "nav": 0,
          "links": 0,
          "errs": 0
        },
        {
          "t": "feedback",
          "id": "fb_agg_01",
          "o": "host",
          "rating": "up",
          "tags": ["clear_structure"]
        }
      ]
    },
    {
      "id": "accept_pseudonymous_feedback_with_comment",
      "expect_accepted": true,
      "expected_http_status": 204,
      "ticket_overrides": {
        "mode": "pseudonymous",
        "sub": "sub_user:9f86d081884c7d659a2feaa0c55ad015",
        "vwr": {
          "k": "sub_user",
          "p": "9f86d081884c7d659a2feaa0c55ad015",
          "t": "platform"
        },
        "cap": ["view", "feedback"]
      },
      "events": [
        {
          "t": "feedback",
          "id": "fb_pseudo_01",
          "o": "host",
          "rating": "down",
          "tags": ["needs_example"],
          "comment": "Section 2 formula step needs one worked example."
        }
      ]
    },
    {
      "id": "reject_oversized_batch_over_64kb",
      "expect_accepted": false,
      "expected_reason": "batch_too_large",
      "expected_http_status": 204,
      "raw_size_bytes": 66000
    },
    {
      "id": "reject_invalid_ticket_signature",
      "expect_accepted": false,
